# Azure OpenAI Settings
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_API_VERSION="2023-12-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME="your-deployment-name" # E.g., gpt-4 or gpt-35-turbo

# Microsoft Graph API / SharePoint Settings (Application Permissions)
GRAPH_TENANT_ID="your-azure-ad-tenant-id"
GRAPH_CLIENT_ID="your-app-client-id"
GRAPH_CLIENT_SECRET="your-app-client-secret"

# The specific SharePoint Site ID to search within
SHAREPOINT_SITE_ID="your-tenant.sharepoint.com,site-collection-id,site-id"
